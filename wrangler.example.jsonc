{
	"name": "mail2telegram",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-15",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	"keep_vars": true,
	"kv_namespaces": [
		{
			"binding": "DB",
			"id": ""
		}
	],
	"vars": {
		"DOMAIN": "mail2telegram.YOUR_NAME.workers.dev"
		// Secrets 建议用控制台 / wrangler secret：
		//   TELEGRAM_BOT=token,chat_id
		//   GEMINI_API_KEY=AIza...
		// 可选 Vars：
		//   FORWARD_LIST=backup@gmail.com
	}
}
