{
	"name": "mail2telegram",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-15",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	"keep_vars": true,
	"kv_namespaces": [
		{
			"binding": "DB",
			"id": "YOUR_KV_NAMESPACE_ID"
		}
	],
	"vars": {
		"UI_LANG": "en"
		// Required: TELEGRAM_BOT=token,chat_id  +  KV binding name DB
		// Recommended secrets/vars:
		//   GEMINI_API=AIza...
		//   FORWARD_MAIL=you+bak@gmail.com,Backup,noforwarded
		//   WEB_USER=username,password
		// Optional: GEMINI_MODEL, TIMEZONE, GMAIL_U (browser Gmail u/N slot), BLOCK_POLICY,
		//   GUARDIAN_MODE, MAX_EMAIL_SIZE, MAX_EMAIL_SIZE_POLICY, RESEND_API_KEY, DEBUG
		// Preview: hard max 100 bodies. Without WEB_USER: web link token 1d.
		// With WEB_USER: login for /email + /init. /previewmode switches Mini App ↔ Web.
		// Public host: open https://<worker-host>/ (status) or /init (saved to KV). No DOMAIN var.
	}
}
