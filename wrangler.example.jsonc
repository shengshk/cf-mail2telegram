{
	"name": "mail2telegram",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-15",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	"keep_vars": true,
	"kv_namespaces": [
		{
			"binding": "DB",
			"id": "YOUR_KV_NAMESPACE_ID"
		}
	],
	"vars": {
		"UI_LANG": "en"
		// Secrets (dashboard / wrangler secret):
		//   TELEGRAM_BOT=token,chat_id
		//   GEMINI_API_KEY=AIza...
		// Optional (single backup + preview retention):
		//   FORWARD_MAILS=you+bak@gmail.com,Backup,noforwarded
		//   MAILS_TTL=1d,10
		//   GMAIL_U=0
		// Public host: open https://<worker-host>/init once (saved to KV). No DOMAIN var.
	}
}
