{
	"name": "mail2telegram",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-15",
	"compatibility_flags": [
		"nodejs_compat_v2"
	],
	"keep_vars": true,
	"kv_namespaces": [
		{
			"binding": "DB",
			"id": "YOUR_KV_NAMESPACE_ID"
		}
	],
	"vars": {
		"UI_LANG": "en"
		// Secrets (dashboard / wrangler secret):
		//   TELEGRAM_BOT=token,chat_id
		//   GEMINI_API_KEY=AIza...
		// Optional:
		//   FORWARD_EMAIL=you+bak@gmail.com,Backup
		//   FORWARD_EMAIL0=other@outlook.com
		//   GMAIL_U=0
		// Public host: open https://<worker-host>/init once (saved to KV). No DOMAIN var.
	}
}
